# NemotronLabs VoiceChat 11B - GGUF server
# Copy this file to .env and review the paths before use.

# Source pin. The converters and runtime must use the same fork commit.
VC_REF=f45001fc3d8013c72beb6753d3eb0b976b6a9fff
CUDA_ARCH=86
CUDA_VERSION=12.8.1

# Bind to localhost by default because the voice endpoint has no authentication.
# Change to 0.0.0.0 only on a network you trust or protect with a firewall/proxy.
BIND_ADDR=127.0.0.1
PORT=9070

# Model and converter storage. Relative paths are resolved from this directory.
MODEL_DIR=./models
CONVERT_WORK=./.cache/llama-voicechat.cpp
HF_HOME=./.cache/huggingface
SRC_QUANT=Q8_0
N_GPU_LAYERS=99

# Known-working default: the speech encoder shipped inside VoiceChat.
# The README covers using another compatible encoder checkpoint.
ASR_MODEL=container
ASR_DIR=

# Legacy whole-wav turn mode. The Realtime bridge uses the duplex stream path.
VC_NO_BARGE=1
VC_FORCE_BOS=1
VC_QUIET=10
SESSION_SECONDS=180
EXTRA_DECODING_SECONDS=50
TEMP=0.0

# Speech activity UI/lifecycle hints; every audio frame still reaches the model.
VAD_SILENCE_MS=700
VAD_MARGIN=3.5
VAD_MIN_SPEECH_MS=350
VAD_MAX_TURN_MS=30000

# Realtime speech output and tool-call lifecycle.
STREAM_FRAMES=8
TOOL_TIMEOUT_S=60
VC_STREAM_COMPARE=
LOG_LEVEL=INFO
