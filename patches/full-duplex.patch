+
+bool mtmd_audio_preprocessor_parakeet::stream_push(const float * samples, size_t n_samples,
+                                                    std::vector<mtmd_audio_mel> & output, bool flush) {
+    output.clear();
+    if (norm_per_feature || stream_is_flushed || (n_samples > 0 && samples == nullptr)) {
+        return false;
+    }
+    if (stream_samples.empty()) {
+        stream_reset();
+    }
