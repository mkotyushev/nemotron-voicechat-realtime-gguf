+bool vc_session::start_duplex() {
+    if (duplex) {
+        ev.error("duplex mode is already running");
+        return false;
+    }
+    sys_done = true;
+    if (mtmd_voicechat_stream_reset(ctx_mtmd.get()) != 0) {
+        ev.error("could not reset the streaming perception encoder");
+        return false;
+    }
+    duplex = true;
+    duplex_encoder_frames = 0;
+    duplex_initial_response = true;
+    duplex_input_speaking = false;
+    duplex_speech_epoch = 0;
+    duplex_consumed_speech_epoch = 0;
+    ev.emit(json{{"kind", "duplex_start"}, {"t", t}, {"frame_rate", 12.5}});
+    return true;
+}
