+        }
+        duplex_eos = false;
+        duplex_frames_after_eos = 0;
+        duplex_pad_streak = 0;
+        ev.emit(json{{"kind", "response_boundary"}, {"response", n_turns}, {"t", t - 1}});
+        return;
+    }
+    ++n_turns;
+    duplex_response = true;
+    duplex_eos = false;
+    duplex_initial_response = false;
+    duplex_response_first = t - 1;
+    duplex_frames_after_eos = 0;
+    duplex_pad_streak = 0;
+    duplex_spoken = 0;
+    duplex_transcript.clear();
+
+    tts_turn_first = tts ? voicechat_tts_n_frames(tts) : 0;
+    stream_next = -1;
+    stream_seq = 0;
+    tts_first_tok = -1;
+    tts_released = 0;
+    tts_voiced = 0;
+    tts_wait = 0;
