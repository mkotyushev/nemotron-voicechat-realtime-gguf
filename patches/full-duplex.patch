+        const float raw = samples[i];
+        const float value = stream_has_prev_sample ? raw - 0.97f * stream_prev_sample : raw;
+        stream_samples.push_back(value);
+        stream_prev_sample = raw;
+        stream_has_prev_sample = true;
+    }
+    if (flush) {
+        stream_samples.resize(stream_samples.size() + (size_t) hparams.audio_n_fft / 2, 0.0f);
+        stream_is_flushed = true;
+    }
+
+    const int frame_size = hparams.audio_n_fft;
+    const int frame_step = hparams.audio_hop_len;
+    const int window_size = hparams.audio_window_len;
+    if (stream_samples.size() < (size_t) frame_size) {
+        return true;
+    }
+
+    const size_t n_stable = (stream_samples.size() - frame_size) / frame_step + 1;
+    if (n_stable <= stream_n_frames) {
+        return true;
+    }
