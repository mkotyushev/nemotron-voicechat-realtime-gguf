+
+bool vc_session::duplex_step(const float * a, bool feed_tts, llama_token force_func) {
+    hold_bos = false;
+    want_bos = false;
+    // Once an audible response has completed, a quantized text head can emit a
+    // late bos and echo its final sentence over silence.  Keep advancing both
+    // model timelines, but hold the output heads at pad until the bridge has
+    // observed a genuinely new speech onset.  This is not a half-duplex turn
+    // gate: the first response and every armed response can still begin while
+    // the user is speaking, and a barge-in keeps the current response open.
+    const bool idle_conditioning = !duplex_response && !duplex_initial_response &&
+        duplex_speech_epoch <= duplex_consumed_speech_epoch;
+    if (!step(a, idle_conditioning, force_func, feed_tts)) {
+        return false;
+    }
+
+    const llama_token id = last_text;
+    if (id == tok_bos) {
+        duplex_open_response();
+    } else if (id == tok_eos) {
+        duplex_pad_streak = 0;
+        if (duplex_response) {
+            duplex_eos = true;
+            duplex_frames_after_eos = 0;
+        }
+    } else if (id != tok_pad) {
+        duplex_pad_streak = 0;
+        if (!duplex_response) {
+            // A quantized head may occasionally skip the bos boundary.
+            duplex_open_response();
+            if (tts && tts_first_tok < 0) {
+                tts_first_tok = std::max(tts_turn_first, voicechat_tts_n_frames(tts) - 1);
+            }
+        }
+        const std::string piece = common_token_to_piece(lctx, id, false);
+        if (!piece.empty()) {
+            ev.text_delta(piece);
+        }
+        duplex_transcript += common_token_to_piece(lctx, id, true);
+        ++duplex_spoken;
+    } else if (duplex_response) {
+        ++duplex_pad_streak;
+    }
+
+    if (has_fhead) {
+        const llama_token f = last_func;
+        if (f == fhead.tok_sotc) {
+            duplex_in_call = true;
+            duplex_wait = 0;
+            duplex_call_buf.clear();
+            LOG_INF("frame %d: sotc, duplex tool call starts\n", t);
+            ev.emit(json{{"kind", "tool_call_start"}, {"t", t}});
+        } else if (f == fhead.tok_eotc && duplex_in_call) {
+            duplex_in_call = false;
+            LOG_INF("frame %d: eotc, duplex tool call: %s\n", t, duplex_call_buf.c_str());
+            ev.emit(json{{"kind", "tool_call"}, {"t", t}, {"text", duplex_call_buf}});
+            std::string answer = on_tool_call ? on_tool_call(duplex_call_buf) : std::string();
+            if (!answer.empty()) {
+                if (answer.compare(0, 15, "<TOOL_RESPONSE>") != 0) {
+                    answer = "<TOOL_RESPONSE>[" + answer + "]</TOOL_RESPONSE>";
+                }
+                duplex_inject = common_tokenize(lctx, answer, false, true);
+                duplex_inject_i = 0;
+                duplex_wait = 0;
+                LOG_INF("frame %d: duplex tool response, %d tokens\n", t, (int) duplex_inject.size());
+                ev.emit(json{{"kind", "tool_response"}, {"t", t},
+                             {"text", answer}, {"tokens", (int) duplex_inject.size()}});
+            } else {
+                LOG_WRN("frame %d: no duplex tool response, the model answers without one\n", t);
+            }
+        } else if (f == fhead.tok_eotr) {
+            duplex_want_eotr = false;
+            LOG_INF("frame %d: eotr, duplex tool response ends\n", t);
+            ev.emit(json{{"kind", "tool_response_end"}, {"t", t}});
+        } else if (duplex_in_call) {
+            const std::string piece = common_token_to_piece(lctx, f);
+            duplex_call_buf += piece;
+            ev.func_delta(piece);
+        }
+
+        if (!duplex_inject.empty() && duplex_inject_i == duplex_inject.size() &&
+            !duplex_want_eotr && f != fhead.tok_eotr) {
+            duplex_inject.clear();
+            duplex_inject_i = 0;
+            duplex_want_eotr = true;
+            duplex_wait = 0;
+        }
+        if (duplex_want_eotr && duplex_wait > 8) {
+            ev.emit(json{{"kind", "warning"},
+                         {"message", "no eotr after the tool response"}});
+            duplex_want_eotr = false;
+        }
+        if (duplex_in_call && duplex_wait > 200) {
+            ev.emit(json{{"kind", "warning"},
+                         {"message", "tool call did not close after 200 frames"}});
+            duplex_in_call = false;
+        }
+    }
+
+    const bool text_done = duplex_eos ||
+        duplex_pad_streak >= (quiet_env > 0 ? quiet_env : n_quiet_frames);
+    if (duplex_response && text_done && feed_tts) {
+        ++duplex_frames_after_eos;
+        const bool speech_done = !tts ||
+            (tts_q.empty() && duplex_frames_after_eos >= n_drain_min &&
+             tts_quiet >= n_drain_quiet);
+        if (speech_done && !duplex_input_speaking) {
+            duplex_finish_response("completed");
+        }
+    }
+    return true;
+}
