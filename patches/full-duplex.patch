+bool vc_session::run_duplex_audio(const std::string & pcm_b64, int64_t seq,
+                                  int64_t speech_epoch, bool input_speaking) {
+    if (!duplex) {
+        ev.error("audio_frame before duplex_start");
+        return false;
+    }
+    if (t >= n_frames_max) {
+        ev.emit(json{{"kind", "warning"}, {"message", "session frame cap reached"}});
+        ev.emit(json{{"kind", "duplex_frame"}, {"seq", seq}, {"frames", 0}, {"t", t}});
+        return true;
+    }
+
+    duplex_speech_epoch = std::max(duplex_speech_epoch, speech_epoch);
+    duplex_input_speaking = input_speaking;
+
+    std::string pcm;
+    try {
+        pcm = base64::decode(pcm_b64);
+    } catch (const std::exception & e) {
+        ev.error(std::string("invalid audio_frame base64: ") + e.what());
+        return false;
+    }
+    if ((pcm.size() & 1) != 0) {
+        ev.error("audio_frame has an odd PCM byte count");
+        return false;
+    }
+
+    std::vector<float> samples(pcm.size() / 2);
+    for (size_t i = 0; i < samples.size(); ++i) {
+        const uint16_t lo = (uint8_t) pcm[2 * i];
+        const uint16_t hi = (uint8_t) pcm[2 * i + 1];
+        samples[i] = (int16_t) (lo | (hi << 8)) / 32768.0f;
+    }
+    if (mtmd_voicechat_stream_feed(ctx_mtmd.get(), samples.data(), samples.size(), false) != 0) {
+        ev.error("streaming perception encoder failed");
+        return false;
+    }
+
+    const size_t total = mtmd_voicechat_stream_get_n_frames(ctx_mtmd.get());
+    const size_t n_new = total - duplex_encoder_frames;
+    const float * out = mtmd_get_output_embd(ctx_mtmd.get());
+    for (size_t i = 0; i < n_new && t < n_frames_max; ++i) {
+        if (!duplex_step(out + i * (size_t) n_embd, true)) {
+            return false;
+        }
+
+        // Tool calls are zero-audio positions. Complete the splice before the
+        // next microphone frame is accepted.
+        int frozen = 0;
+        while ((duplex_in_call || duplex_inject_i < duplex_inject.size() ||
+                duplex_want_eotr) && t < n_frames_max) {
+            llama_token force = -1;
+            if (duplex_inject_i < duplex_inject.size()) {
+                force = duplex_inject[duplex_inject_i++];
+            }
+            ++duplex_wait;
+            if (!duplex_step(nullptr, false, force)) {
+                return false;
+            }
+            if (++frozen > 512) {
+                ev.error("tool splice exceeded 512 frames");
+                return false;
+            }
+        }
+    }
+    duplex_encoder_frames = total;
+    ev.emit(json{{"kind", "duplex_frame"}, {"seq", seq},
+                 {"samples", samples.size()}, {"frames", n_new}, {"t", t}});
+    return true;
+}
