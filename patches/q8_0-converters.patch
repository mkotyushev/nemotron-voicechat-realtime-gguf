+def dequant_q8_0(raw: bytes, n_elements: int) -> np.ndarray:
+    """Q8_0: per block of 32, one f16 scale then 32 signed bytes."""
+    n_blocks = n_elements // 32
+    b = np.frombuffer(raw, dtype=np.uint8).reshape(n_blocks, 34)
+    d = b[:, :2].copy().view(np.float16).astype(np.float32)  # {n_blocks, 1}
+    q = b[:, 2:].view(np.int8).astype(np.float32)
+    return (q * d).reshape(-1)
+
+
+def file_type_for(path) -> int:
+    """general.file_type for the output, taken from the source file's name.
+
+    Only metadata — llama.cpp prints it and does not gate on it — but a Q8_0
+    set that announces itself as Q4_0 is a lie in every log line that mentions
+    it. The converters upstream hardcode Q4_0 because that is the only
+    quantization the published `llamacpp/` folder was built from.
+    """
+    import gguf
+
+    name = str(path)
+    if "Q8_0" in name:
+        return gguf.LlamaFileType.MOSTLY_Q8_0
+    if "Q4_0" in name:
+        return gguf.LlamaFileType.MOSTLY_Q4_0
+    return gguf.LlamaFileType.MOSTLY_F16
+
+
 class GGUFSource:
