+// Decode and emit whatever speech has piled up since the last call.
+//
+// `flush` empties the buffer at the end of a turn; otherwise a chunk only goes
+// out once stream_chunk frames are ready, because every decode pays for its
+// causal run-up and one frame at a time would be mostly run-up.
+void vc_session::stream_audio(bool flush) {
+    if (!tts || stream_chunk <= 0) {
+        return;
+    }
+    // Nothing is worth sending before the turn's first audible token: the
+    // frames before it are the leading </s><s> pair and the stretch where the
+    // model sat listening, which is silence the client does not need.
+    if (tts_first_tok < 0) {
+        return;
+    }
+    if (stream_next < 0) {
+        // Same trim the final wav uses: start half a second before the first
+        // spoken token so the chunk does not open on a codec transient.
+        stream_next = std::max(tts_turn_first, tts_first_tok - 6);
+    }
+
+    const int have  = voicechat_tts_n_frames(tts);
+    const int ready = have - stream_next;
+    if (ready <= 0 || (!flush && ready < stream_chunk)) {
+        return;
+    }
+
+    char path[1024];
+    snprintf(path, sizeof(path), "%s/vc-delta-%d-%d.wav",
+             stream_dir.c_str(), n_turns, stream_seq);
+
+    if (!voicechat_tts_write_wav(tts, path, stream_next, ready)) {
+        ev.error(std::string("could not write ") + path);
+        // Do not retry the same range forever; skip it and keep the turn alive.
+        stream_next = have;
+        return;
+    }
+
+    ev.emit(json{{"kind", "audio_delta"}, {"turn", n_turns}, {"seq", stream_seq},
+                 {"path", path}, {"first", stream_next}, {"frames", ready},
+                 {"seconds", ready / 12.5}, {"final", flush}});
+
+    stream_next = have;
+    ++stream_seq;
+}
